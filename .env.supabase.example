# ─────────────────────────────────────────────────────
# Configuración de Supabase para Dulce Encanto
# ─────────────────────────────────────────────────────
# Password recibido: $NDR·$S,.-´+`¡
# Password URL-encoded: %24NDR%C2%B7%24S%2C.-%C2%B4%2B%60%C2%A1
# ─────────────────────────────────────────────────────

# 1. URL de tu proyecto Supabase (Project Settings → API → API endpoint)
SUPABASE_URL="https://jzetdfegilsdphbfusmm.supabase.co"

# 2. Anon public key (Project Settings → API → Project API keys)
SUPABASE_ANON_KEY="sb_publishable_C3L7H7yEH3NXnnFlPJekuQ_R9Ngdzli"

# 3. Service role key (NO exponer en el frontend → solo backend)
# Haz clic en "Reveal" en Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# 4. Project reference
SUPABASE_PROJECT_REF="jzetdfegilsdphbfusmm"

# 5. DATABASE_URL con password URL-encoded
# Password: $NDR·$S,.-´+`¡
# URL-encoded: %24NDR%C2%B7%24S%2C.-%C2%B4%2B%60%C2%A1
# Usa el pooler para conexiones desde Render/externo:
DATABASE_URL="postgresql://postgres.jzetdfegilsdphbfusmm:%24NDR%C2%B7%24S%2C.-%C2%B4%2B%60%C2%A1@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# 6. JWT secrets (genera con: openssl rand -base64 32)
JWT_ACCESS_SECRET="dulce-encanto-access-secret-2026-cambia-esto-32chars"
JWT_REFRESH_SECRET="dulce-encanto-refresh-secret-2026-cambia-esto-32chars"

# 7. AES-256-GCM encryption (64 hex chars o 32 UTF-8 chars)
AES_KEY="0123456789abcdef0123456789abcdef"
AES_KEY_PREVIOUS=""

BCRYPT_ROUNDS="12"
PORT="4000"
FRONTEND_URL="https://lemichiw-cyber.github.io/si-ventas-/"
NODE_ENV="production"

# ─────────────────────────────────────────────────────
# Nota sobre conexionión a Supabase desde Render:
# Render debe estar en la misma región que tu proyecto Supabase
# para evitar latencia. El pooler (aws-0-us-west-1.pooler.supabase.com)
# permite conexiones concurrentes.
#
# Si la conexión falla con "tenant/user not found", verifica:
# 1. El password es correcto (URL-encoded si tiene special chars)
# 2. El pooler es el correcto para tu región
# 3. El usuario es: postgres.<project_ref>
