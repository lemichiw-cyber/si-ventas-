# ─────────────────────────────────────────────────────
# Configuración de Supabase para Dulce Encanto
# ─────────────────────────────────────────────────────

# 1. URL de tu proyecto Supabase (Project Settings → API → API endpoint)
SUPABASE_URL="https://jzetdfegilsdphbfusmm.supabase.co"

# 2. Anon public key (Project Settings → API → Project API keys)
SUPABASE_ANON_KEY="sb_publishable_C3L7H7yEH3NXnnFlPJekuQ_R9Ngdzli"

# 3. Service role key (NO exponer en el frontend → solo backend)
# Haz clic en "Reveal" en Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# 4. Project reference
SUPABASE_PROJECT_REF="jzetdfegilsdphbfusmm"

# 5. Para usar Supabase con Prisma, reemplaza el schema:
#    En backend/package.json, cambia:
#      "prisma:generate": "prisma generate --schema=prisma/schema.supabase.prisma"
#      "prisma:push": "prisma db push --schema=prisma/schema.supabase.prisma"
#    O usa un symlink:
#      ln -sf prisma/schema.supabase.prisma prisma/schema.prisma
#
# 6. DATABASE_URL con tu password (remplaza [PASSWORD] con tu password de Supabase)
DATABASE_URL="postgresql://postgres:[TU-PASSWORD]@db.jzetdfegilsdphbfusmm.supabase.co:5432/postgres"

# 7. JWT secrets (genera con: openssl rand -base64 32)
JWT_ACCESS_SECRET="genera-tu-propio-secret-de-al-menos-32-chars"
JWT_REFRESH_SECRET="genera-tu-propio-secret-de-al-menos-32-chars"

# 8. AES-256-GCM encryption (genera con: openssl rand -hex 32)
AES_KEY="genera-tu-key-de-64-hex-chars"
AES_KEY_PREVIOUS=""  # key anterior para rotación de llaves

BCRYPT_ROUNDS="12"
PORT="4000"
FRONTEND_URL="https://lemichiw-cyber.github.io/si-ventas-/"
NODE_ENV="production"
