# ─────────────────────────────────────────────────────
# Configuración de Supabase para Dulce Encanto
# ─────────────────────────────────────────────────────

# URL de tu proyecto Supabase (lo encuentras en Project Settings → API → API endpoint)
SUPABASE_URL="https://jzetdfegilsdphbfusmm.supabase.co"

# Anon public key (Project Settings → API → Project API keys)
SUPABASE_ANON_KEY="sb_publishable_C3L7H7yEH3NXnnFlPJekuQ_R9Ngdzli"

# Service role key (NUNCA expongas esto en el frontend — solo backend)
# Project Settings → API → service_role (click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=""

# Project reference
SUPABASE_PROJECT_REF="jzetdfegilsdphbfusmm"

# Para usar Supabase como base de datos para Prisma (PostgreSQL)
# Reemplaza [PASSWORD] con tu password de la base de datos
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.jzetdfegilsdphbfusmm.supabase.co:5432/postgres"

# JWT secrets (genera con: openssl rand -base64 32)
JWT_ACCESS_SECRET="CHANGE-ME-le-debo-poner-tu-secret-de-32-chars-acceso"
JWT_REFRESH_SECRET="CHANGE-ME-le-debo-poner-tu-secret-de-32-chars-refresh"

# AES-256 encryption (genera con: openssl rand -hex 32)
AES_KEY="CHANGE-ME-tu-key-de-32-chars-o-64-hex"
AES_KEY_PREVIOUS=""  # opcional: key anterior para rotación de llaves

BCRYPT_ROUNDS="12"
PORT="4000"
FRONTEND_URL="https://lemichiw-cyber.github.io"
NODE_ENV="production"

# Frontend
VITE_API_URL="https://dulce-encanto.onrender.com/api"
