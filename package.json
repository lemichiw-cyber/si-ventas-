{
  "name": "dulce-encanto",
  "private": true,
  "version": "1.0.0",
  "description": "Dulce Encanto - Mermeladas Artesanales E-commerce",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "seed": "npm --workspace backend run seed",
    "prisma:generate": "npm --workspace backend run prisma:generate",
    "prisma:push": "npm --workspace backend run prisma:push"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
