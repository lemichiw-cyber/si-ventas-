# Backend
# Para dev local (SQLite):
DATABASE_URL="file:./dev.db"
# Para producción PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/dulce_encanto?schema=public"
JWT_ACCESS_SECRET="super-secret-access-key-change-me-32chars!!"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-me-32chars!!"
AES_KEY="0123456789abcdef0123456789abcdef" # 32 bytes hex or ascii for AES-256
AES_IV="abcdef9876543210abcdef9876543210" # 16 bytes for demo; en prod usa random IV por registro
BCRYPT_ROUNDS="12"
PORT="4000"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Frontend
VITE_API_URL="http://localhost:4000/api"
