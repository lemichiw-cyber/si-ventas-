# ══════════════════════════════════════════════
#  Dulce Encanto / SiVentas — Variables de entorno
#  Copia a .env y ajusta:  cp .env.example .env
# ══════════════════════════════════════════════

# Puerto HTTP (Render inyecta PORT automáticamente)
PUERTO=3000

# Ruta del archivo SQLite (por defecto data/dulce-encanto.db)
# DB_ARCHIVO=/app/data/tienda.db

# Secreto JWT — OBLIGATORIO en producción. Genera uno:
#   openssl rand -hex 32
JWT_SECRETO=genera-un-secreto-largo-y-aleatorio
TOKEN_HORAS=168

# ── Tienda ──
IVA=0.15
COSTO_ENVIO=1.5
ENVIO_GRATIS_DESDE=15

# ── Emails (opcional; sin claves se simulan en consola) ──
EMAIL_SIMULADO=true
EMAIL_DE="Dulce Encanto <pedidos@tudominio.com>"
EMAIL_ADMIN=duena@tudominio.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com
